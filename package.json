{
  "name": "@consilioweb/payload-support",
  "version": "4.0.0",
  "description": "Payload CMS plugin — professional support & ticketing system with AI, SLA, time tracking, live chat, and more",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./views": {
      "import": {
        "types": "./dist/views.d.ts",
        "default": "./dist/views.js"
      }
    },
    "./components/TicketConversation": {
      "import": {
        "types": "./dist/components/TicketConversation/index.d.ts",
        "default": "./dist/components/TicketConversation/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "!src/__tests__",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.types.json && node scripts/copy-subpath-types.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "keywords": [
    "payload",
    "payload-cms",
    "payload-plugin",
    "support",
    "ticketing",
    "helpdesk",
    "customer-support",
    "sla",
    "time-tracking",
    "live-chat",
    "ai",
    "csat",
    "knowledge-base",
    "webhooks",
    "email-tracking",
    "canned-responses",
    "macros",
    "round-robin",
    "crm",
    "i18n",
    "nextjs",
    "react",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pOwn3d/payload-support.git"
  },
  "homepage": "https://github.com/pOwn3d/payload-support#readme",
  "bugs": {
    "url": "https://github.com/pOwn3d/payload-support/issues"
  },
  "author": "ConsilioWEB <contact@consilioweb.fr> (https://consilioweb.fr)",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "peerDependencies": {
    "@payloadcms/next": "^3.37.0",
    "lucide-react": ">=0.300.0",
    "next": "^15.2.9 || ^16.0.0",
    "payload": "^3.37.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@payloadcms/db-sqlite": "^3.88.0",
    "@payloadcms/graphql": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/translations": "^3.88.0",
    "@payloadcms/ui": "^3.88.0",
    "@playwright/test": "^1.63.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.18",
    "@types/sanitize-html": "^2.16.1",
    "@types/web-push": "^3.6.4",
    "esbuild-sass-plugin": "^3.7.0",
    "next": "^16.3.4",
    "payload": "^3.88.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "0.34.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "pdfkit": "^0.19.1",
    "sanitize-html": "^2.17.7",
    "web-push": "^3.6.7"
  }
}
